# Rito Mimarlik static origin for Cloudflare-proxied production traffic.
# Replace every {{...}} token before installation. The Cloudflare real-IP
# include must contain current set_real_ip_from entries from Cloudflare's
# official IPv4 and IPv6 lists.

server {
    listen 80;
    listen [::]:80;
    server_name {{PRIMARY_HOST}};

    return 301 https://{{PRIMARY_HOST}}$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{PRIMARY_HOST}};

    root /srv/www/rito-mimarlik/current;
    index index.html;

    ssl_certificate {{ORIGIN_CERTIFICATE_PATH}};
    ssl_certificate_key {{ORIGIN_PRIVATE_KEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RITO_MIMARLIK_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/cloudflare-realip.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    access_log /var/log/nginx/rito-mimarlik.access.log;
    error_log /var/log/nginx/rito-mimarlik.error.log warn;

    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'self'; worker-src 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    error_page 404 /404.html;

    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    location = /404.html {
        internal;
        expires -1;
    }

    location ~ /\. {
        deny all;
    }

    location ~* \.(?:css|js)$ {
        expires 1h;
        try_files $uri =404;
    }

    location ~* \.(?:avif|webp|jpe?g|png|gif|svg|ico)$ {
        expires 7d;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ =404;
    }
}
